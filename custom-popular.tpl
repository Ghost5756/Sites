<a class="popular-item d-flex ai-center" href="{full-link}">
    <div class="popular-item__img img-fixed-size">
        <img src="[xfvalue_thumb_url_poster]" alt="{title}" loading="lazy">
    </div>
    <div class="popular-item__desc flex-grow-1">
        <div class="popular-item__title ws-nowrap">{title}</div>
        <div class="popular-item__meta ws-nowrap">Фильмы</div>
        <div class="popular-item__rating fas fa-star">{ratingscorelikes}</div>
    </div>
</a>