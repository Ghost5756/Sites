<div class="pagination ignore-select d-flex jc-center" id="pagination">
    <div class="pagination__pages d-flex flex-grow-1">{pages}</div>
    <div class="pagination__btns d-flex">
        [prev-link]<i class="pagination__btn pagination__btn--prev far fa-arrow-left"></i>[/prev-link]
        [next-link]<i class="pagination__btn pagination__btn--next far fa-arrow-right"></i>[/next-link]
    </div>
</div>