<a href="{full-link}" class="fs-result d-flex ai-center">
    <div class="fs-result__img img-fit-cover">
        <img src="[xfvalue_thumb_url_poster]" alt="{title}" loading="lazy">
    </div>
    <div class="fs-result__desc flex-grow-1">
        <div class="fs-result__title line-clamp">{title}</div>
        <div class="fs-result__meta d-flex ai-center">
            <div class="flex-grow-1">2023, Сериалы</div>
            <div class="fs-result__rating far fa-star"> {ratingscorelikes}</div>
        </div>
    </div>
</a>